# Configuration pour# Note: These are placeholders and# DO NOT commit values to production!

# ─── Security ─────────────────────────────────────
SECRET_KEY=your-super-secret-key-at-least-32-characters
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCloAK_URL=https://your-keycloak-instance.com/auth/realms/schoolflow
KEYCLOAK_CLIENT_ID=schoolflow-backend

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/schoolflow

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=schoolflow
MINIO_SECURE=False

# Debug
DEBUG=False
LOG_level=INFO

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Email / Notifications (Optional) ────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@schoolflow.com

# ─── External Services (Optional) ────────────────────
# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ENVIRONMENT=production
