# ============================================
# EtudePlus / SchoolFlow Pro Configuration
# ============================================
# Copy this file to .env and adjust values

# ============================================
# DATABASE (PostgreSQL)
# ============================================
POSTGRES_DB=schoolflow
POSTGRES_USER=schoolflow
POSTGRES_PASSWORD=schoolflow123
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://schoolflow:schoolflow123@postgres:5432/schoolflow

# ============================================
# KEYCLOAK (Identity Provider)
# ============================================
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak123
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=schoolflow
KEYCLOAK_CLIENT_ID=schoolflow-frontend
KEYCLOAK_CLIENT_SECRET=

# URLs for backend
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ISSUER=http://keycloak:8080/realms/schoolflow
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/schoolflow/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=schoolflow-frontend

# ============================================
# MINIO (S3-Compatible Storage)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=schoolflow
MINIO_ENDPOINT=minio:9000

# ============================================
# REDIS (Cache & Sessions)
# ============================================
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ============================================
# PGADMIN (Database Admin)
# ============================================
PGADMIN_EMAIL=admin@schoolflow.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ============================================
# APPLICATION SETTINGS
# ============================================
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
DEBUG=True
LOG_LEVEL=INFO
APP_NAME=SchoolFlow Pro
APP_VERSION=1.0.0

# CORS - comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# API
API_PORT=8000

# ============================================
# FRONTEND (Vite Environment Variables)
# ============================================
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=schoolflow
VITE_KEYCLOAK_CLIENT_ID=schoolflow-frontend

# ============================================
# DOCKER SERVICES PORTS
# ============================================
FRONTEND_PORT=3000

# ============================================
# BACKUP SETTINGS
# ============================================
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ============================================
# PRODUCTION OVERRIDES
# ============================================
# Uncomment and set these for production deployment
# DEBUG=False
# SECRET_KEY=<generate-with: openssl rand -hex 32>
# KEYCLOAK_CLIENT_SECRET=<from-keycloak-client-configuration>
# MINIO_SECURE=True
# VAULT_ENABLED=False
